# Choose the reasoning provider: gemini | sarvam | auto | fallback
# auto prefers Gemini when configured, then Sarvam, then the local fallback.
AI_PROVIDER=auto

# Gemini (optional)
GEMINI_API_KEY=your_gemini_api_key_here

# Sarvam (optional). Get a key from https://dashboard.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_MODEL=sarvam-105b
